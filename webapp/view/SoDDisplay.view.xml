<mvc:View
    controllerName="rnow.approval.corner.controller.SoDDisplay"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uiTable="sap.ui.table"
    xmlns:core="sap.ui.core">
    <Page
        id="sodDisplayPage"
        showHeader="false">
        <content>
            <!-- Header -->
            <VBox class="sapUiSmallMarginBottom">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    width="100%"
                    class="headerRow">
                    <HBox alignItems="Center">
                        <Button
                            icon="sap-icon://nav-back"
                            type="Transparent"
                            press="onNavBack"/>
                        <VBox class="sapUiSmallMarginBegin">
                            <Image
                                src="{appUser>/logo}"
                                height="2.75rem"
                                densityAware="false"
                                class="reviewNowLogo"/>
                            <Title
                                text="{sodDisplayModel>/pageTitle}"
                                level="H3"/>
                        </VBox>
                    </HBox>
                </HBox>
            </VBox>
            <!-- Toolbar -->
			<OverflowToolbar >
				<Title
                    text="{i18n>displayClosedItems}"
                    level="H5"/>
				<ToolbarSpacer/>
				<Button
                    text="{i18n>btnCancel}"
                   icon="sap-icon://sys-cancel"
                    type="Transparent"
                    press="onCancel"/>
			</OverflowToolbar>
            <!-- SOD Display Table -->
            <uiTable:Table
                id="sodDisplayTable"
                rows="{sodDisplayModel>/Items}"
                selectionMode="MultiToggle"
                enableBusyIndicator="true"
                enableColumnReordering="true"
                visibleRowCountMode="Auto">
                <uiTable:columns>
                    <!-- Risk ID -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="RiskId"
                        filterProperty="RiskId"
                        width="5rem">
                        <Label text="{i18n>displayRiskId}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>RiskId}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Risk Description -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="RiskDescn"
                        filterProperty="RiskDescn"
                        width="24rem">
                        <Label text="{i18n>displayRiskDescription}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>RiskDescn}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Risk Level -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="RiskLevel"
                        filterProperty="RiskLevel"
                        width="6rem">
                        <Label text="{i18n>displayRiskLevel}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>RiskLevel}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Function ID -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="Function"
                        filterProperty="Function"
                        width="6rem">
                        <Label text="{i18n>displayFunctionId}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>Function}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Function Description -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="FunctDesc"
                        filterProperty="FunctDesc"
                        width="15rem">
                        <Label text="{i18n>displayFunctionDescription}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>FunctDesc}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Mitigation ID -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="Mcid"
                        filterProperty="Mcid"
                        width="7rem">
                        <Label text="{i18n>displayMitigationId}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>Mcid}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Conflict -->
                    <uiTable:Column
                        hAlign="Center"
                        sortProperty="LineCount"
                        filterProperty="LineCount"
                        width="6rem">
                        <Label text="{i18n>displayConflict}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>LineCount}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Risk Action -->
                    <uiTable:Column
                        hAlign="Center"
                        width="7.5rem">
                        <Label text="{i18n>displayRiskAction}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>Action}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Mit. Action -->
                    <uiTable:Column
                        hAlign="Center"
                        width="7.5rem">
                        <Label text="{i18n>displayMitAction}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>MidAction}"/>
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- Comments -->
                    <uiTable:Column
                        hAlign="Center"
                        width="200px">
                        <Label text="{i18n>displayComment}"/>
                        <uiTable:template>
                            <Text text="{sodDisplayModel>Comment}"/>
                        </uiTable:template>
                    </uiTable:Column>
                </uiTable:columns>
            </uiTable:Table>
        </content>
    </Page>
</mvc:View>