<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="reassignDialog"
        title="{i18n>dlgReassignTitle}"
        icon="sap-icon://add-employee"
        draggable="true"
        resizable="true"
        contentWidth="500px">
        <content>
            <VBox class="sapUiMediumMargin">
                <Label
                    text="{i18n>lblReviewerName}"
                    required="true"/>
                <Input
                    id="reviewerNameInput"
                    value="{reassign>/reviewer}"
                    placeholder="{i18n>placeholderReviewerName}"
                    showValueHelp="true"
                    valueHelpRequest=".onReviewerValueHelp"
                    change="onReviewerChange"/>
                                <Label
                                        text="{i18n>lblReason}"
                                        required="true"
                                        class="sapUiSmallMarginTop"/>
                                <TextArea
                                    id="reassignComment"
                                        rows="4"
                                        width="100%"
                                        value="{reassign>/reason}"
                                        placeholder="{i18n>placeholderReason}"/>
            </VBox>
        </content>
        <beginButton>
            <Button
                icon="sap-icon://add-employee"
                text="{i18n>btnReassign}"
                type="Accept"
                press="onReassignConfirm"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>btnCancel}"
                press="onReassignCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>