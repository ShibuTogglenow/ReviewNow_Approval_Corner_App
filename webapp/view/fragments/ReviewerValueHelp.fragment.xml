<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="reviewerVHDialog"
        contentHeight="500px"
        title="{i18n>dlgSelectReviewer}"
        search="onReviewerVHSearch"
        confirm="onReviewerVHConfirm"
        cancel="onReviewerVHCancel"
        items="{
           path:'/Reassign_VHSet'
        }">
       <StandardListItem
            title="{REVIEWER}"
            description="{REVIEWERNAME}"
            type="Active"/>
    </SelectDialog>
</core:FragmentDefinition>