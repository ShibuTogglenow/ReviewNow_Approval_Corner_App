                                    </uiTable:template>
                                </uiTable:Column>
                                <uiTable:Column hAlign="Center" width="7rem" sortProperty="EUSER" filterProperty="EUSER">
                                    <Label text="{i18n>colUserName}"/>
                                    <uiTable:template>
                                        <Text text="{main>EUSER}"/>
                                    </uiTable:template>
                                </uiTable:Column>
                               <!-- First Name -->
                                <uiTable:Column
                                    hAlign="Center"
                                    width="7rem"
                                    filterProperty="FIRSTNAME">
                                    <Label text="{i18n>colFirstName}"/>
                                    <uiTable:template>
                                        <Text text="{main>FIRSTNAME}"/>
                                    </uiTable:template>
                                </uiTable:Column>

                                <!-- Last Name -->
                                <uiTable:Column
                                    hAlign="Center"
                                    width="7rem"
                                    filterProperty="LASTNAME">
                                    <Label text="{i18n>colLastName}"/>
                                    <uiTable:template>
