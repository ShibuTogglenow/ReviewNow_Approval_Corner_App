<mvc:View
    controllerName="rnow.approval.corner.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uiTable="sap.ui.table">

    <Page id="mainPage" showHeader="false">
        <content>

            <VBox class="sapUiSmallMarginBottom">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    width="100%"
                    class="headerRow">
                    <VBox>
                        <Image
                            src="{appUser>/logo}"
                            height="2.75rem"
                            densityAware="false"
                            class="reviewNowLogo"/>
                        <Title
                            text="{main>/pageTitle}"
                            level="H3"/>
                    </VBox>
                </HBox>
            </VBox>

            <IconTabBar
                id="mainTabBar"
                select="onTabSelect"
                selectedKey="{main>/selectedKey}">
                <items>

                    <!-- ==================== New ==================== -->
                    <IconTabFilter
                        key="New"
                        text="{= ${i18n>tabNew} + ' (' + (${main>/NewCount} || 0) + ')' }">

                        <uiTable:Table
                            id="newTable"
                            rows="{main>/New}"
                            selectionMode="MultiToggle"
                            rowSelectionChange="onRowSelectionChange"
                            alternateRowColors="true"
                            enableBusyIndicator="true"
                            enableColumnReordering="true"
                            visibleRowCountMode="Auto"
                            minAutoRowCount="15">

                            <uiTable:extension>
                                <OverflowToolbar>
                                    <Title text="{i18n>mainApprovalItems}" level="H5"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        icon="sap-icon://show"
                                        text="{i18n>btnReview}"
                                        type="Transparent"
                                        press="onReview"/>
                                    <Button
                                        icon="sap-icon://refresh"
                                        text="{i18n>btnRefresh}"
                                        type="Transparent"
                                        press="onNewRefresh"/>
                                    <Button
                                        icon="sap-icon://add-employee"
                                        text="{i18n>btnReassign}"
                                        type="Transparent"
                                        press="onReassign"/>
                                </OverflowToolbar>
                            </uiTable:extension>

                            <uiTable:columns>
                                <uiTable:Column hAlign="Center" width="7rem" filterProperty="CONNECTOR">
                                    <Label text="{i18n>colConnector}"/>
                                    <uiTable:template>
                                        <Text text="{main>CONNECTOR}"/>
                                    </uiTable:template>
                                </uiTable:Column>
                                <uiTable:Column hAlign="Center" width="5rem" filterProperty="JOB_ID">
                                    <Label text="{i18n>colJobId}"/>
                                    <uiTable:template>
                                        <Text text="{main>JOB_ID}"/>
                                    </uiTable:template>
                                </uiTable:Column>
                                <uiTable:Column hAlign="Center" width="14rem" filterProperty="REVCYCLENAME">
                                    <Label text="{i18n>colJobName}"/>
                                    <uiTable:template>
                                        <Text text="{main>REVCYCLENAME}"/>
                                    </uiTable:template>
                                </uiTable:Column>
                                <uiTable:Column hAlign="Center" width="3rem" filterProperty="ATT_FISCAL">
                                    <Label text="{i18n>colFiscalYear}"/>
                                    <uiTable:template>
                                        <Text text="{main>ATT_FISCAL}"/>
                                    </uiTable:template>
                                </uiTable:Column>
                                <uiTable:Column hAlign="Center" width="4rem" filterProperty="ATT_QUARTERLY">
                                    <Label text="{i18n>colFiscalQuarter}"/>
