                                    </uiTable:template>
                                </uiTable:Column>

                                <!-- Lock Status -->
                                <uiTable:Column
                                    hAlign="Center"
                                    width="7rem"
                                    filterProperty="LockStatus">
                                    <Label text="{i18n>colLockStatus}"/>
                                    <uiTable:template>
                                        <Text text="{main>LockStatus}"/>
                                    </uiTable:template>
                                </uiTable:Column>

                                <!-- Last Logon Date -->
                                <uiTable:Column
                                    hAlign="Center"
                                    width="8.5rem"
                                    filterProperty="LastLogon">
                                    <Label text="{i18n>colLastLogonDate}"/>
                                    <uiTable:template>
                                        <Text text="{main>LastLogon}"/>
                                    </uiTable:template>
                                </uiTable:Column>
