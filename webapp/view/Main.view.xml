                                    <Title text="{i18n>mainClosedItems}" level="H5"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        icon="sap-icon://refresh"
                                        text="{i18n>btnRefresh}"
                                        type="Transparent"
                                        press="onClosedRefresh"/>
                                    <Button
                                        icon="sap-icon://show"
                                        text="{i18n>mainDisplay}"
                                        type="Transparent"
